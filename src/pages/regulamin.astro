---
import Base from '@/layouts/Base.astro';
import Button from '@/components/primitives/Button.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import PageFooter from '@/components/layout/PageFooter.astro';
import DocNav from '@/components/regulamin/DocNav.astro';
import LegalDocument from '@/components/regulamin/LegalDocument.astro';
import { legalClosing, legalDocuments } from '@/content/legal';
import { cta, site } from '@/content/site';
import { routes } from '@/lib/routes';
---

<Base
  title="Regulamin, RODO i polityka prywatności"
  description="Zasady przekazywania materiałów, klauzula informacyjna RODO oraz polityka prywatności Copyisto."
>
  <div class="page">
    <PageHeader logoHref={routes.home}>
      <Button href={cta.formHref} variant="solid" size="xs">
        {cta.openForm}
      </Button>
    </PageHeader>

    <main class="legal-main page-main gutter">
      <DocNav />

      <div class="legal-column">
        {legalDocuments.map((doc, i) => (
          <div>
            {i > 0 && <hr class="legal-rule" />}
            <LegalDocument {doc} spaced={i > 0} />
          </div>
        ))}

        <div class="legal-cta">
          <p class="legal-cta-question">{legalClosing.question}</p>
          <Button href={cta.formHref} variant="primary" size="md" class="legal-cta-button">
            {cta.donateShort}
          </Button>
        </div>
      </div>
    </main>

    <PageFooter links={false} note={`${site.domain} · ${site.stage}`} />
  </div>
</Base>

<style>
  .legal-main {
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    align-items: start;
    gap: clamp(28px, 5vw, 72px);
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
    padding-top: clamp(32px, 5vw, 64px);
    padding-bottom: clamp(56px, 7vw, 96px);
  }

  @media (max-width: 760px) {
    .legal-main {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .legal-column {
    min-width: 0;
    max-width: 74ch;
  }

  .legal-rule {
    margin-block: clamp(48px, 6vw, 80px);
    border: 0;
    border-top: 1px solid var(--color-rule-18);
  }

  .legal-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-lg);
    margin-top: clamp(48px, 6vw, 80px);
    padding: clamp(24px, 3vw, 34px);
    border: 1px solid var(--color-rule-25);
    background: var(--color-field);
  }

  /* :global for the same reason: it lands on the Button component. */
  :global(.legal-cta-button) {
    white-space: nowrap;
  }

  .legal-cta-question {
    max-width: 30ch;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.3;
  }
</style>
