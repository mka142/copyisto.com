---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import PageFooter from '@/components/layout/PageFooter.astro';
import FormIntro from '@/components/formularz/FormIntro.astro';
import ScanRules from '@/components/formularz/ScanRules.astro';
import CreditsInfo from '@/components/formularz/CreditsInfo.astro';
import UploadForm from '@/components/formularz/UploadForm.astro';
import { site } from '@/content/site';
import { routes } from '@/lib/routes';
---

<Base
  title="Przekaż materiały"
  description="Prześlij zeskanowane zadania z harmonii, pomóż wytrenować model i zyskaj bezpłatny wczesny dostęp."
>
  <div class="page">
    <PageHeader logoHref={routes.home}>
      <a href={routes.home} class="header-back">
        ← Wróć na stronę główną
      </a>
    </PageHeader>

    <main class="page-main">
      <div class="form-intro-wrap gutter">
        <FormIntro />
      </div>
      <ScanRules />
      <CreditsInfo />
      <UploadForm />
    </main>

    <PageFooter note={site.domain} />
  </div>
</Base>

<style>
  .form-intro-wrap {
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
    padding-top: var(--space-column);
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  .header-back {
    color: var(--color-ink-soft);
    font-size: var(--text-base);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
  }

  .header-back:hover {
    color: var(--color-rust);
    text-decoration: none;
  }
</style>
