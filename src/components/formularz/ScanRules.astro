---
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import PlaceholderTile from '@/components/primitives/PlaceholderTile.astro';
import { scanRules } from '@/content/formularz';
---

<section class="rules gutter" id="jak-skanowac">
  <div class="rules-shell">
    <Eyebrow class="rules-eyebrow">{scanRules.eyebrow}</Eyebrow>
    <h2 class="rules-title">{scanRules.title}</h2>
    <p class="rules-lead">{scanRules.body}</p>

    <div class="rules-grid">
      {scanRules.rules.map((rule) => (
        <article class="rule">
          <PlaceholderTile badge={rule.badge} caption={rule.tileCaption} tone="paper" />
          <div class="rule-copy">
            <span class="ornament ornament-md rule-num">{rule.number}</span>
            <p class="rule-body">
              <strong class="rule-lead">{rule.lead}</strong> {rule.body}
            </p>
          </div>
        </article>
      ))}
    </div>

    <div class="rules-note">
      <p class="rules-note-title">{scanRules.note.title}</p>
      <p class="rules-note-body">{scanRules.note.body}</p>
    </div>
  </div>
</section>

<style>
  .rules {
    padding-block: var(--space-section-form);
    border-top: 1px solid var(--color-rule);
    background: var(--color-band);
    scroll-margin-top: 24px;
  }

  .rules-shell {
    max-width: 1180px;
    margin-inline: auto;
  }

  /* :global because this class is handed to a child component, and a
     parent's scoped styles never reach a child's markup. */

  :global(.rules-eyebrow) {
    margin-bottom: 20px;
  }

  .rules-title {
    max-width: 22ch;
    margin: 0 0 14px;
    font-family: var(--font-serif);
    font-size: clamp(28px, 3.2vw, 44px);
    font-weight: 500;
    letter-spacing: -0.012em;
    line-height: 1.12;
    text-wrap: pretty;
  }

  .rules-lead {
    max-width: 60ch;
    margin: 0 0 clamp(32px, 4vw, 52px);
    color: var(--color-ink-soft);
    font-size: var(--text-xl);
    line-height: 1.66;
    text-wrap: pretty;
  }

  .rules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: var(--space-card-sm);
  }

  .rule {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    min-width: 0;
  }

  .rule-copy {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-sm);
  }

  .rule-num {
    flex-shrink: 0;
  }

  .rule-body {
    margin: 0;
    color: var(--color-ink-soft);
    line-height: 1.66;
    text-wrap: pretty;
  }

  .rule-lead {
    color: var(--color-ink);
    font-weight: 700;
  }

  .rules-note {
    max-width: 76ch;
    margin-top: clamp(32px, 4vw, 52px);
    padding: clamp(20px, 2.5vw, 28px) clamp(20px, 2.5vw, 30px);
    border-left: 3px solid var(--color-rust);
    background: var(--color-paper);
  }

  .rules-note-title {
    margin: 0 0 10px;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(19px, 1.8vw, 23px);
    line-height: 1.3;
  }

  .rules-note-body {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-body);
    line-height: 1.68;
    text-wrap: pretty;
  }
</style>
