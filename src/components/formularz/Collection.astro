---
import Button from '@/components/primitives/Button.astro';
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import Newsletter from '@/components/landing/Newsletter.astro';
import { collection } from '@/content/formularz';
import { icons } from '@/lib/icons';
import { mailto, social } from '@/lib/routes';

const { local, remote } = collection;

// Direct-message channels show only once their username is set.
const channels = [
  { href: social.instagram, label: local.instagram, icon: icons.instagram, channel: 'instagram' },
  { href: social.messenger, label: local.messenger, icon: icons.messenger, channel: 'messenger' },
].filter((c) => c.href);
---

<section class="collection gutter" id="zbiorka">
  <div class="collection-grid">
    <div class="collection-card collection-local">
      <Eyebrow class="collection-eyebrow">{local.eyebrow}</Eyebrow>
      <h2 class="display-sm collection-title">{local.title}</h2>
      <p class="collection-body">{local.body}</p>
      <div class="collection-actions">
        <Button
          href={mailto}
          variant="primary"
          size="md"
          data-track="email_clicked"
          data-track-location="collection_local"
        >
          <span class="collection-btn">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={icons.email} />
            </svg>
            {local.email}
          </span>
        </Button>
        {channels.map((c) => (
          <Button
            href={c.href}
            variant="outline"
            size="md"
            data-track="dm_clicked"
            data-track-channel={c.channel}
            data-track-location="collection_local"
          >
            <span class="collection-btn">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={c.icon} />
              </svg>
              {c.label}
            </span>
          </Button>
        ))}
      </div>
    </div>

    <div class="collection-card collection-remote">
      <Newsletter eyebrow={remote.eyebrow} title={remote.title} body={remote.body} />
    </div>
  </div>
</section>

<style>
  .collection {
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
    scroll-margin-top: 24px;
  }

  .collection-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--gap-2xl);
  }

  .collection-card {
    min-width: 0;
    padding: var(--space-card);
    box-shadow: 5px 6px 0 var(--color-ink-12);
  }

  .collection-local {
    border: 1px solid var(--color-rule-30);
    background: var(--color-bright);
  }

  .collection-remote {
    background: var(--color-dark);
    color: var(--color-dark-fg);

    /* Native controls (the newsletter checkbox) render their dark variant. */
    color-scheme: dark;
  }

  /* The newsletter lays itself out in two columns for the wide footer;
     in a half-width card intro and form stack. */
  .collection-remote :global(.news) {
    grid-template-columns: minmax(0, 1fr);
  }

  /* :global because this class is handed to a child component, and a
     parent's scoped styles never reach a child's markup. */

  :global(.collection-eyebrow) {
    margin-bottom: 16px;
  }

  .collection-title {
    margin-bottom: 12px;
  }

  .collection-body {
    max-width: 46ch;
    margin: 0 0 26px;
    color: var(--color-ink-soft);
    font-size: var(--text-body);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .collection-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-sm);
  }

  .collection-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2xs);
  }

  .collection-btn svg {
    flex: none;
    width: 18px;
    height: 18px;
    fill: currentcolor;
  }
</style>
