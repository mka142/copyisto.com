---
import Button from '@/components/primitives/Button.astro';
import { routes } from '@/lib/routes';
---

<!--
  Asks once, before any analytics loads. Not modal: the page stays readable
  and usable behind it, and closing it (Escape) without a choice is not consent.
-->
<section class="consent" role="dialog" aria-labelledby="consent-title" data-consent hidden>
  <h2 class="consent-title" id="consent-title">
    Pliki cookies
  </h2>
  <p class="consent-text">
    Za Twoją zgodą korzystamy z PostHog do analityki i nagrań sesji, żeby wiedzieć, co na stronie
    działa. Szczegóły znajdziesz w{' '}
    <a href={routes.privacy} class="prose-link">
      polityce prywatności
    </a>
    .
  </p>
  <div class="consent-actions">
    <Button type="button" variant="solid" size="sm" data-consent-choice="granted">
      Akceptuję
    </Button>
    <Button type="button" variant="solid" size="sm" data-consent-choice="denied">
      Odrzucam
    </Button>
  </div>
</section>

<script>
  import { startAnalytics, stopAnalytics } from '@/lib/analytics';
  import { readConsent, writeConsent, type Consent } from '@/lib/consent';

  const banner = document.querySelector<HTMLElement>('[data-consent]')!;
  // The control that reopened the banner, so focus can return to it.
  let opener: HTMLElement | null = null;

  const open = (from: HTMLElement | null) => {
    opener = from;
    banner.hidden = false;
    if (from) banner.querySelector<HTMLButtonElement>('[data-consent-choice]')?.focus();
  };

  const close = () => {
    banner.hidden = true;
    opener?.focus();
    opener = null;
  };

  const consent = readConsent();
  if (consent === 'granted') startAnalytics();
  if (consent === null) open(null);

  // Capture phase on window runs before PostHog's own click listener, so a
  // withdrawal takes effect before the "Odrzucam" click itself is recorded.
  window.addEventListener(
    'click',
    (event) => {
      const choice = (event.target as Element).closest<HTMLElement>('[data-consent-choice]');
      if (choice) choose(choice);
    },
    { capture: true },
  );

  function choose(choice: HTMLElement) {
    const value = choice.dataset.consentChoice as Consent;
    writeConsent(value);
    if (value === 'granted') startAnalytics();
    else stopAnalytics();
    close();
  }

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !banner.hidden) close();
  });

  // "Ustawienia cookies" in the footer.
  document.addEventListener('click', (event) => {
    const trigger = (event.target as Element).closest<HTMLElement>('[data-consent-open]');
    if (trigger) open(trigger);
  });
</script>

<style>
  .consent {
    position: fixed;
    right: 16px;
    bottom: 16px;
    left: 16px;
    z-index: 70;
    max-width: 440px;
    padding: 20px 22px 22px;
    border: 1px solid var(--color-rule-30);
    background: var(--color-paper);
    box-shadow: 5px 6px 0 var(--color-ink-12);
  }

  .consent[hidden] {
    display: none;
  }

  .consent-title {
    margin: 0 0 8px;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 400;
    line-height: 1.3;
  }

  .consent-text {
    margin: 0 0 18px;
    color: var(--color-ink-soft);
    font-size: var(--text-base);
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* Two equal buttons: same size, same style, neither one the default. */
  .consent-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-2xs);
  }

  /* :global because the buttons are Button components, outside this scope. */
  .consent-actions :global(.btn:focus-visible) {
    outline: 2px solid var(--color-rust);
    outline-offset: 3px;
  }
</style>
