---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['eyebrow', className]}>
  <span class="eyebrow-rule" aria-hidden="true"></span>
  <span class="eyebrow-label"><slot /></span>
</div>

<style>
  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
  }

  .eyebrow-rule {
    display: block;
    flex-shrink: 0;
    width: 40px;
    height: 1px;
    background: var(--color-rust);
  }

  /* Sentence-case italic rather than tracked capitals: a note in the margin. */
  .eyebrow-label {
    color: var(--color-rust);
    font-size: var(--text-md);
    font-style: italic;
    font-weight: 500;
  }
</style>
