---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { labelmeBoxes, type Labelme } from '@/lib/labelme';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Detection boxes to replay over the image. */
  boxes?: Labelme;
}

const { src, alt, boxes } = Astro.props;
const rects = boxes ? labelmeBoxes(boxes) : [];
---

<figure class="annotated" data-reveal={boxes ? '' : undefined}>
  <Image src={src} alt={alt} widths={[640, 1280, 1920]} sizes="(max-width: 660px) 100vw, 640px" />
  {boxes && (
    // Box coordinates live in the labelled image's pixels, so the overlay
    // only has to match the image's aspect ratio, not its resolution.
    <svg
      class="annotated-boxes"
      viewBox={`0 0 ${boxes.imageWidth} ${boxes.imageHeight}`}
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      {rects.map((r) => (
        <rect
          data-label={r.label}
          x={r.x}
          y={r.y}
          width={r.width}
          height={r.height}
          style={`--x: ${(r.x / boxes.imageWidth).toFixed(3)}`}
        />
      ))}
    </svg>
  )}
</figure>

<script>
  import '@/lib/reveal';
</script>

<style>
  .annotated {
    position: relative;
    width: 100%;
    margin: 0;
  }

  .annotated :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .annotated-boxes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .annotated-boxes rect {
    fill: none;
    stroke-width: 1.5px;
    vector-effect: non-scaling-stroke;
    transform-box: fill-box;
    transform-origin: center;

    /* Replay timing: when a label's pass starts and how long it sweeps across. */
    --in: 0s;
    --sweep: 0.8s;
  }

  /* ---- one colour per label, scaffolding hidden at rest */

  .annotated-boxes [data-label='staff'] {
    --in: 0s;

    stroke: var(--color-label-staff);
  }

  .annotated-boxes [data-label='system'] {
    --in: 1s;
    --sweep: 0.4s;

    stroke: var(--color-label-system);
  }

  .annotated-boxes [data-label='treble_clef'] {
    --in: 2s;
    --sweep: 0.3s;

    stroke: var(--color-label-treble-clef);
  }

  .annotated-boxes [data-label='bass_clef'] {
    --in: 2s;
    --sweep: 0.3s;

    stroke: var(--color-label-bass-clef);
  }

  .annotated-boxes [data-label$='barline'] {
    --in: 2.6s;

    stroke: var(--color-label-barline);
  }

  .annotated-boxes [data-label='note_up'] {
    --in: 3.4s;
    --sweep: 1.2s;

    stroke: var(--color-label-note-up);
  }

  .annotated-boxes [data-label='note_down'] {
    --in: 3.4s;
    --sweep: 1.2s;

    stroke: var(--color-label-note-down);
  }

  .annotated-boxes [data-label='note'] {
    --in: 3.4s;
    --sweep: 1.2s;

    stroke: var(--color-label-note);
  }

  .annotated-boxes [data-label='tie'] {
    --in: 4.8s;

    stroke: var(--color-label-tie);
  }

  /* Staffs and systems only guide the later passes, so they end hidden. */
  .annotated-boxes :is([data-label='staff'], [data-label='system']) {
    opacity: 0;
  }

  .is-armed rect {
    opacity: 0;
  }

  .is-playing rect {
    animation: box-in 0.45s ease-out calc(var(--in) + var(--x) * var(--sweep)) both;
  }

  .is-playing :is([data-label='staff'], [data-label='system']) {
    animation:
      box-in 0.45s ease-out calc(var(--in) + var(--x) * var(--sweep)) both,
      box-out 0.8s ease-in 6.2s forwards;
  }

  @keyframes box-in {
    from {
      opacity: 0;
      transform: scale(1.12);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes box-out {
    from {
      opacity: 1;
    }

    to {
      opacity: 0;
    }
  }
</style>
