---
/**
 * A mounted print: bright paper, hairline edge and the house offset shadow,
 * so artwork sits on its own sheet instead of the section's band. The label
 * is a small tab naming what the figure shows.
 */
interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<div class:list={['frame', className]}>
  <span class="frame-label">{label}</span>
  <slot />
</div>

<style>
  .frame {
    position: relative;
    min-width: 0;
    padding: clamp(12px, 1.6vw, 22px);
    padding-top: clamp(30px, 3vw, 40px);
    border: 1px solid var(--color-rule-30);
    background: var(--color-bright);
    box-shadow: 5px 6px 0 var(--color-ink-12);
  }

  .frame-label {
    position: absolute;
    top: clamp(10px, 1vw, 14px);
    left: clamp(12px, 1.6vw, 22px);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-style: italic;
    line-height: 1;
  }
</style>
