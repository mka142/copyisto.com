---
/**
 * The hatched box the design uses wherever final artwork is still missing.
 * Kept verbatim so the open items stay visible rather than quietly disappearing.
 */
interface Props {
  badge: string;
  caption: string;
  /** Aspect ratio, matching the design's two sizes. */
  ratio?: '4/3' | '3/2';
  /** Which paper shade the tile sits on; the scan rules sit on the band. */
  tone?: 'field' | 'paper';
}

const { badge, caption, ratio = '4/3', tone = 'field' } = Astro.props;
---

<div class:list={['tile', 'hatch', `tile-on-${tone}`]} style={`aspect-ratio:${ratio}`}>
  <span class="tile-badge">{badge}</span>
  <span class="tile-caption">{caption}</span>
</div>

<style>
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: 14px;
    border: 1px solid var(--color-rule-30);
  }

  /* `tone` replaces what used to be a parent-side .rule-tile override; a
     parent's scoped styles cannot reach a class passed into a child. */
  .tile-on-field {
    background: var(--color-field);
  }

  .tile-on-paper {
    background: var(--color-paper);
    padding: 16px;
  }

  .tile-badge {
    position: relative;
    align-self: flex-start;
    color: var(--color-rust);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .tile-caption {
    position: relative;
    color: var(--color-muted);
    font-size: var(--text-caption);
    line-height: 1.45;
  }
</style>
