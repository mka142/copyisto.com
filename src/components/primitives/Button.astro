---
/**
 * Renders a <button> when given no href, and an <a> otherwise.
 * `mailto:` and absolute URLs are left as plain anchors.
 */
export type ButtonVariant =
  /** Rust block with a hard ink shadow. The page's main call to action. */
  | 'primary'
  /** Solid ink. Used for form submits and the compact header CTA. */
  | 'solid'
  /** Hairline outline on paper. */
  | 'outline'
  /** Ember block with a hard paper shadow, for use on the dark footer. */
  | 'onDark'
  /** Hairline outline on the dark footer. */
  | 'onDarkOutline';

export type ButtonSize = 'lg' | 'md' | 'sm' | 'xs';

interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: ButtonVariant;
  size?: ButtonSize;
  class?: string;
  /** Shrinks below 420px, as the design does for the header CTA. */
  compact?: boolean;
  [key: string]: unknown;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'lg',
  class: className,
  compact = false,
  ...rest
} = Astro.props;

const classes = ['btn', `btn-${variant}`, `btn-${size}`, compact && 'btn-compact', className];
---

{href ? (
  <a href={href} class:list={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class:list={classes} {...rest}>
    <slot />
  </button>
)}

<style>
  .btn {
    display: inline-block;
    border: 0;
    border-radius: 2px;
    cursor: pointer;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-align: center;
    text-decoration: none;
    transition:
      background-color 140ms ease,
      color 140ms ease,
      box-shadow 140ms ease,
      border-color 140ms ease;
  }

  /* Sizes */
  .btn-lg {
    padding: 17px 30px;
    font-size: var(--text-lg);
  }

  .btn-md {
    padding: 14px 26px;
    font-size: var(--text-body);
  }

  .btn-sm {
    padding: 12px 18px;
    font-size: var(--text-label);
  }

  .btn-xs {
    padding: 9px 16px;
    font-size: var(--text-meta);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* Variants */
  .btn-primary {
    background: var(--color-rust);
    color: var(--color-paper);
    box-shadow: 3px 3px 0 var(--color-ink);
  }

  .btn-primary:hover {
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: 3px 3px 0 var(--color-rust);
    text-decoration: none;
  }

  .btn-solid {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .btn-solid:hover {
    background: var(--color-rust);
    color: var(--color-paper);
    text-decoration: none;
  }

  .btn-outline {
    border: 1px solid var(--color-rule-35);
    background: transparent;
    color: var(--color-ink);
  }

  .btn-outline:hover {
    border-color: var(--color-rust);
    color: var(--color-rust);
    text-decoration: none;
  }

  .btn-onDark {
    background: var(--color-ember);
    color: var(--color-ember-fg);
    box-shadow: 3px 3px 0 var(--color-paper-90);
  }

  .btn-onDark:hover {
    background: var(--color-dark-fg-strong);
    color: var(--color-ink);
    box-shadow: 3px 3px 0 var(--color-ember);
    text-decoration: none;
  }

  .btn-onDarkOutline {
    border: 1px solid var(--color-dark-rule-40);
    background: transparent;
    color: var(--color-dark-fg-strong);
  }

  .btn-onDarkOutline:hover {
    background: var(--color-dark-fg-strong);
    color: var(--color-ink);
    text-decoration: none;
  }

  /* `compact` replaces the old parent-side .header-cta override. */
  @media (max-width: 420px) {
    .btn-compact {
      padding: 10px 14px;
      font-size: var(--text-sm);
    }
  }
</style>
