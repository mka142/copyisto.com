---
import { howItWorks } from '@/content/landing';

/**
 * Stands in for the animation promised in step three. The design ships this
 * as an explicit placeholder, so it is reproduced rather than invented.
 */
const { preview } = howItWorks;
---

<div class="xml-preview hatch">
  <div class="xml-preview-head">
    <span class="xml-preview-badge">{preview.badge}</span>
    <span class="xml-preview-format">{preview.format}</span>
  </div>

  <div class="xml-preview-stage" aria-hidden="true">
    <div class="xml-staff xml-staff-before">
      <div class="xml-staff-lines xml-staff-lines-skew"></div>
    </div>
    <span class="xml-preview-arrow">→</span>
    <div class="xml-staff xml-staff-after">
      <div class="xml-staff-lines"></div>
      <div class="xml-staff-flag"></div>
    </div>
  </div>

  <div class="xml-preview-error">{preview.error}</div>
  <p class="xml-preview-caption">{preview.caption}</p>
</div>

<style>
  .xml-preview {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 4 / 3;
    padding: 18px;
    border: 1px solid var(--color-rule-30);
    background: var(--color-paper);
    overflow: hidden;
  }

  .xml-preview-head {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--gap-2xs);
  }

  .xml-preview-badge {
    padding: 5px 9px;
    border: 1px solid var(--color-rust-rule);
    background: var(--color-paper);
    color: var(--color-rust);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .xml-preview-format {
    padding: 5px 8px;
    border: 1px solid var(--color-rule-22);
    background: var(--color-paper);
    color: var(--color-muted);
    font-size: var(--text-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .xml-preview-stage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 18px 1fr;
    align-items: center;
    align-self: center;
    gap: 6px;
    width: 92%;
  }

  .xml-staff {
    position: relative;
    height: 62px;
  }

  .xml-staff-before {
    border: 1px dashed var(--color-rule-30);
    background: var(--color-field);
  }

  .xml-staff-after {
    border: 1px solid var(--color-ink-28);
    background: var(--color-bright);
  }

  .xml-staff-lines {
    position: absolute;
    top: 16px;
    left: 10%;
    right: 10%;
    height: 30px;
    background: repeating-linear-gradient(
      to bottom,
      var(--color-ink-42) 0 1px,
      transparent 1px 7.5px
    );
  }

  .xml-staff-lines-skew {
    transform: rotate(-1.6deg);
    background: repeating-linear-gradient(
      to bottom,
      var(--color-ink-30) 0 1px,
      transparent 1px 7.5px
    );
  }

  .xml-staff-flag {
    position: absolute;
    top: 12px;
    left: 38%;
    width: 22px;
    height: 38px;
    border: 1.5px solid var(--color-error);
    background: var(--color-error-12);
  }

  .xml-preview-arrow {
    color: var(--color-rust);
    font-size: var(--text-lg);
    font-weight: 700;
    text-align: center;
  }

  .xml-preview-error {
    position: relative;
    align-self: flex-end;
    max-width: 84%;
    padding: 9px 12px;
    border-radius: 2px;
    background: var(--color-error);
    color: var(--color-error-fg);
    font-size: var(--text-fine);
    font-weight: 500;
    line-height: 1.45;
  }

  .xml-preview-caption {
    position: relative;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
</style>
