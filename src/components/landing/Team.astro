---
import { team, teamStatement } from '@/content/team';
---

<section class="band team gutter" id="zespol">
  <div class="team-shell">
    <h2 class="display team-title">Zespół Copyisto</h2>

    <div class="team-grid">
      {team.map((member) => (
        <div class="team-member">
          <div class="team-avatar" aria-hidden="true">
            Placeholder
            <br />
            zdjęcie
          </div>
          <div class="team-member-copy">
            <h3 class="team-name">{member.name}</h3>
            <p class:list={['team-bio', member.emphasised && 'team-bio-quoted']}>{member.bio}</p>
          </div>
        </div>
      ))}
    </div>

    <p class="team-statement">{teamStatement}</p>
  </div>
</section>

<style>
  .team {
    padding-block: var(--space-section);
    scroll-margin-top: 72px;
  }

  .team-shell {
    max-width: 1080px;
    margin-inline: auto;
  }

  .team-title {
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(28px, 4vw, 56px);
    margin-bottom: clamp(36px, 4vw, 56px);
  }

  .team-member {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-lg);
    min-width: 0;
  }

  .team-member-copy {
    min-width: 0;
  }

  .team-avatar {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    padding: 8px;
    border: 1px solid var(--color-rule-30);
    border-radius: 50%;
    background: var(--color-paper);
    color: var(--color-rust);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-align: center;
    text-transform: uppercase;
  }

  .team-name {
    margin: 0 0 8px;
    font-family: var(--font-serif);
    font-size: 25px;
    font-weight: 500;
  }

  .team-bio {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-body);
    line-height: 1.62;
    text-wrap: pretty;
  }

  .team-bio-quoted {
    padding-left: 12px;
    border-left: 2px solid var(--color-rust);
    color: var(--color-muted);
    font-style: italic;
  }

  .team-statement {
    max-width: 52ch;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(19px, 1.8vw, 25px);
    font-style: italic;
    line-height: 1.45;
    text-wrap: pretty;
  }
</style>
