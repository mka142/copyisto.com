---
import { docNav, docNavCaveat, docNavLabel } from '@/content/legal';
---

<nav class="doc-nav" aria-label={docNavLabel}>
  <span class="doc-nav-label">{docNavLabel}</span>
  {docNav.map((item) => (
    <a href={item.href} class:list={['doc-nav-link', item.nested && 'doc-nav-link-nested']}>
      {item.label}
    </a>
  ))}
  <span class="doc-nav-caveat">{docNavCaveat}</span>
</nav>

<style>
  .doc-nav {
    position: sticky;
    top: 24px;
    display: flex;
    flex-direction: column;
    gap: 11px;
    min-width: 0;
    padding-left: 18px;
    border-left: 1px solid var(--color-rule-22);
  }

  .doc-nav-label {
    margin-bottom: 4px;
    color: var(--color-rust);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .doc-nav-link {
    color: var(--color-ink-soft);
    font-size: var(--text-label);
    text-decoration: none;
  }

  .doc-nav-link:hover {
    color: var(--color-rust);
  }

  .doc-nav-link-nested {
    margin-left: -19px;
    padding-left: 12px;
    border-left: 1px solid var(--color-rule-22);
  }

  .doc-nav-caveat {
    margin-top: 14px;
    color: var(--color-faint);
    font-size: var(--text-fine);
    line-height: 1.5;
  }

  /* The source has no breakpoint here, which leaves ~135px of text on a
     phone. Collapse to one column and unpin the nav. */
  @media (max-width: 760px) {
    .doc-nav {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px 18px;
      padding-left: 0;
      padding-bottom: 20px;
      border-left: 0;
      border-bottom: 1px solid var(--color-rule-22);
    }

    .doc-nav-label,
    .doc-nav-caveat {
      flex-basis: 100%;
      margin: 0;
    }

    .doc-nav-link-nested {
      margin-left: 0;
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
