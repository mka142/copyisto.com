---
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import LegalText from './LegalText.astro';
import type { LegalDocument } from '@/content/legal';

interface Props {
  doc: LegalDocument;
  /** Adds the extra heading gap the second and third documents use. */
  spaced?: boolean;
}

const { doc, spaced = false } = Astro.props;
---

<section id={doc.id} class="legal-doc">
  <Eyebrow class="legal-eyebrow">{doc.eyebrow}</Eyebrow>
  <h1 class:list={['legal-title', spaced && 'legal-title-spaced']}>{doc.title}</h1>

  {doc.meta && (
    <p class="legal-meta">
      {doc.meta.map((entry, i) => (
        <span>
          {i > 0 && ' · '}
          {entry.label} <span class="legal-accent">{entry.value}</span>
        </span>
      ))}
    </p>
  )}

  {doc.clauses?.map((clause) => (
    <div>
      <h2 id={clause.id} class="legal-heading">
        {clause.heading}
      </h2>
      {clause.blocks.map((block) =>
        block.kind === 'paragraph' ? (
          <p class="legal-para">
            <LegalText text={block.text} />
          </p>
        ) : (
          <p class="legal-placeholder">
            <strong class="legal-placeholder-label">{block.label}</strong> {block.text}
          </p>
        ),
      )}
    </div>
  ))}

  {doc.definitions && (
    <dl class="legal-defs">
      {doc.definitions.map((d) => (
        <div>
          <dt class="legal-term">{d.term}</dt>
          <dd class:list={['legal-def', d.placeholder && 'legal-def-placeholder']}>
            {d.placeholder ? (
              <Fragment>
                <strong class="legal-placeholder-label">{d.label}</strong> {d.text}
              </Fragment>
            ) : (
              <LegalText text={d.text} accents={d.accents} />
            )}
          </dd>
        </div>
      ))}
    </dl>
  )}
</section>

<style>
  .legal-doc {
    scroll-margin-top: 24px;
  }

  /* :global because this class is handed to a child component, and a
     parent's scoped styles never reach a child's markup. */

  :global(.legal-eyebrow) {
    margin-bottom: 18px;
  }

  .legal-title {
    margin: 0 0 16px;
    font-family: var(--font-serif);
    font-size: clamp(32px, 3.6vw, 50px);
    font-weight: 500;
    letter-spacing: -0.012em;
    line-height: 1.1;
  }

  .legal-title-spaced {
    margin-bottom: 26px;
    font-size: clamp(30px, 3.4vw, 46px);
  }

  .legal-meta {
    margin: 0 0 32px;
    color: var(--color-faint);
    font-size: var(--text-base);
    letter-spacing: 0.02em;
  }

  .legal-heading {
    margin: 0 0 10px;
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.24;
    scroll-margin-top: 24px;
  }

  .legal-para {
    margin: 0 0 26px;
    color: var(--color-ink-soft);
    line-height: 1.72;
    text-wrap: pretty;
  }

  .legal-para:not(:last-child) {
    margin-bottom: 14px;
  }

  .legal-placeholder {
    margin: 0 0 26px;
    padding: 16px 18px;
    border: 1px dashed var(--color-rust-rule-40);
    background: var(--color-field);
    color: var(--color-muted);
    font-size: var(--text-md);
    line-height: 1.66;
    text-wrap: pretty;
  }

  .legal-placeholder-label {
    color: var(--color-rust);
    font-weight: 700;
  }

  .legal-defs {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
    margin: 0;
  }

  .legal-term {
    margin-bottom: 6px;
    color: var(--color-rust);
    font-size: var(--text-note);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .legal-def {
    margin: 0;
    color: var(--color-ink-soft);
    line-height: 1.7;
  }

  .legal-def-placeholder {
    padding: 14px 16px;
    border: 1px dashed var(--color-rust-rule-40);
    background: var(--color-field);
    color: var(--color-muted);
    font-size: var(--text-md);
  }
</style>
