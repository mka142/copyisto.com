---
import Contact from '@/components/landing/Contact.astro';
import FooterBar from './FooterBar.astro';
import { site } from '@/content/site';
---

<footer class="landing-footer gutter">
  <div class="landing-footer-grid">
    <Contact location="landing_footer" />
  </div>

  <div class="landing-footer-bar">
    <FooterBar note={`${site.domain} · ${site.stage}`} />
  </div>
</footer>

<style>
  .landing-footer {
    padding-top: var(--space-section);
    padding-bottom: clamp(32px, 4vw, 48px);
    background: var(--color-dark);
    color: var(--color-dark-fg);
  }

  .landing-footer-grid,
  .landing-footer-bar {
    width: 100%;
    max-width: 1080px;
    margin-inline: auto;
  }

  .landing-footer-bar {
    margin-top: var(--space-stack);
    padding-top: 22px;
    border-top: 1px solid var(--color-dark-rule);
  }
</style>
