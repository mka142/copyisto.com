# Copy to .env for local builds; set the same names as build variables in Cloudflare.
# Usernames only, without @ or a URL. Leave one out to hide its button.
INSTAGRAM_USERNAME=PLACEHOLDER
MESSENGER_USERNAME=PLACEHOLDER

# PostHog browser analytics. Set the same values as build variables in Cloudflare.
PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
PUBLIC_POSTHOG_HOST=https://your-posthog-host
