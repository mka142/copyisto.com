# Copy to .env for local builds; set the same names as build variables in Cloudflare.
# Public contact address for the e-mail buttons and the legal text.
# Defaults to kontakt@copyisto.com when unset.
EMAIL_ADDRESS=hello@example.com

# Full profile URLs for the footer icons and the direct-message buttons.
# Leave one out to hide both.
FACEBOOK_URL=https://www.facebook.com/your-page
INSTAGRAM_URL=https://www.instagram.com/your-account
TWITTER_URL=https://x.com/your-account

# PostHog browser analytics, loaded only after cookie consent. The project must
# live in the EU cloud. Set the same values as build variables in Cloudflare.
PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
